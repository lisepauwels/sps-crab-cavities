% added blocks

\mode<presentation>

\definecolor{cern}{RGB}{0,83,161}

\setbeamercolor{structure}{fg=cern}
\setbeamercolor{footline}{use=structure,fg=structure.fg!50!white, bg=structure.fg}

% =======================================================================
% alert color
%\setbeamercolor{alerted text}{fg=uared}
% =======================================================================

% =======================================================================
% blocks
\setbeamercolor{block title}
		{use=structure,fg=white,bg=cern}
\setbeamercolor{block title alerted}
		{use=alerted text,fg=white,bg=alerted text.fg!75!black}
\setbeamercolor{block title example}
		{use=example text,fg=white,bg=example text.fg!75!black}


\setbeamercolor{block body}
		{fg=cern,use=block title,bg=cern!10!white}
\setbeamercolor{block body alerted}
		{use=block title alerted,
			fg=block title alerted.bg!75!black,bg=block title alerted.bg!10!white}
\setbeamercolor{block body example}
		{use=block title example,
			fg=block title example.bg!75!black,bg=block title example.bg!10!white}

\mode
<all>
